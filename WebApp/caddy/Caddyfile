aver.pef.mendelu.cz {
    encode zstd gzip
    request_body {
        # Above the form's 30 MiB file limit (core/validators.py) by a margin
        # for the multipart framing, so an oversized file gets the translated
        # form message instead of a bare 413 from the proxy. Caddy reads "MB"
        # as 10^6 bytes; MiB is the 2^20 unit the validator uses.
        max_size 32MiB
    }
    reverse_proxy aver:8080

    handle_path /static/* {
        root * /app/static-collected
        # Filenames are content-hashed (ManifestStaticFilesStorage), so a given
        # URL's bytes never change — safe to cache forever. New CSS = new URL.
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
}