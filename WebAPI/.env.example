# AVer WebAPI deployment configuration.
#
# Copy this file to `.env` in the WebAPI directory and edit the values you need:
#     cp .env.example .env
#
# `.env` is sourced by setup_api.sh, start_api.sh, and start_worker.sh, so it
# is the single place to set everything at runtime. install_user_services.sh
# generates minimal unit files (no Environment= lines); the wrappers source
# `.env` on every start, so edits are picked up by a plain
# `systemctl --user restart aver-backend aver-worker`.
# Values left commented out fall back to the defaults shown. `.env` is
# gitignored (it may hold the API key); this `.env.example` is tracked.
#
# Format: plain `KEY=value` (no `export`, no spaces around `=`). After changing
# `.env`, restart the services: `systemctl --user restart aver-backend aver-worker`.

# ---------------------------------------------------------------------------
# Shared (both the web tier and the worker)
# ---------------------------------------------------------------------------

# SQLite job-store file. Both processes MUST point at the same file.
#AVER_DB_PATH=./jobs.db

# Result retention in seconds (default 604800 = 7 days).
#AVER_JOB_TTL_SECONDS=604800

# Log verbosity: DEBUG, INFO, or WARNING.
#AVER_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Web tier (aver-backend / start_api.sh)
# ---------------------------------------------------------------------------

# Shared secret required in the X-API-Key header. Leave unset to DISABLE auth
# (not recommended in production). Set a real value here.
AVER_API_KEY=change-me

# HTTP port.
#AVER_PORT=11122

# gunicorn worker processes for the web tier.
#AVER_WEB_CONCURRENCY=2

# gunicorn request timeout in seconds. Covers the whole request INCLUDING
# reading the upload off the socket, so it has to absorb slow clients sending
# large documents -- not just handler time. 60 s was too tight for ~1 MB POSTs.
#AVER_GUNICORN_TIMEOUT=300

# Threads per gunicorn worker (gthread worker class). Web-tier concurrency;
# distinct from AVER_WEB_THREADS below, which is OMP_NUM_THREADS for the model.
#AVER_GUNICORN_THREADS=4

# CPU threads for the web process (keep small so it doesn't steal cores).
#AVER_WEB_THREADS=1

# Reject POST /document with 429 when this many jobs are queued/processing
# (0 = unbounded).
#AVER_MAX_QUEUE=0

# GET /health is a public endpoint (no API key required) that returns a JSON
# health payload; HTTP 200 when everything is fine and 503 when at least one
# probe raised a problem. Point an external uptime monitor (e.g. UptimeRobot)
# at it. The thresholds below control when /health reports "degraded":
#
#   AVER_HEALTH_HEARTBEAT_STALE_SECONDS  -- worker considered dead if its
#       last heartbeat is older than this (default 60 s; worker heartbeats
#       every AVER_WORKER_POLL_SECONDS ~= 2 s, so 60 s is very generous).
#   AVER_HEALTH_FAILURES_1H_ALERT        -- number of failed jobs in the
#       last hour that trips the alert (default 10).
#   AVER_HEALTH_STUCK_PROCESSING_SECONDS -- a single job "processing" for
#       longer than this triggers a problem. Default 18000 = 5 h. Normal
#       CPU runs take 2-3 h, so 5 h is "definitely stuck".
#   AVER_HEALTH_QUEUE_BACKLOG_ALERT_SECONDS -- oldest queued job (waiting
#       against created_at, not started_at) older than this triggers a
#       problem. Default 172800 = 48 h; a single worker doing 2-3 h per job
#       can legitimately keep a job queued for many hours, so alert only
#       when a queued job has been waiting more than two full days.
#AVER_HEALTH_HEARTBEAT_STALE_SECONDS=60
#AVER_HEALTH_FAILURES_1H_ALERT=10
#AVER_HEALTH_STUCK_PROCESSING_SECONDS=18000
#AVER_HEALTH_QUEUE_BACKLOG_ALERT_SECONDS=172800

# /similarity embedding model (HF id or local path).
#AVER_SIMILARITY_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Cosine cutoff for the boolean `match` returned by /similarity.
#AVER_SIMILARITY_THRESHOLD=0.7172

# ---------------------------------------------------------------------------
# Worker (aver-worker / start_worker.sh)
# ---------------------------------------------------------------------------

# Inference backend: torch (default; use on GPU machines) or openvino (CPU).
#AVER_INFERENCE_BACKEND=torch

# Torch model dtype. BF16 halves model and beam-cache memory on A40/A100 GPUs.
# Keep float32 for production compatibility unless you validate BF16 outputs.
#AVER_MODEL_DTYPE=float32

# Optional NF4 4-bit model weights. This mode requires CUDA and bitsandbytes.
# AVER_MODEL_DTYPE controls the computation dtype in this mode.
#AVER_MODEL_QUANTIZATION=none

# OpenVINO model directory / export (only for the openvino backend).
#AVER_OPENVINO_MODEL_DIR=/model_weights
#AVER_OPENVINO_EXPORT=0

# CPU threads for inference (sets OMP/MKL/OpenBLAS thread counts).
#AVER_WORKER_THREADS=3

# Idle poll interval (seconds) for new jobs.
#AVER_WORKER_POLL_SECONDS=2

# How often (seconds) to purge expired jobs while idle.
#AVER_WORKER_CLEANUP_INTERVAL=3600

# Painless updates: when set to 1, the worker checks git HEAD on every idle
# poll and gracefully exits if the working tree has moved since it booted.
# systemd then starts a fresh process on the new code. Because the check
# runs only between jobs, an in-flight job is never interrupted. Combined
# with TimeoutStopSec=infinity in the systemd unit, this means the operator
# only has to `git pull` -- no manual restart, no drain script.
# Off by default; set to 1 on hosts you want to auto-update.
#AVER_AUTO_RESTART_ON_NEW_COMMIT=0

# Cloze duplicate-candidate deferral: after a repeated word fails LM
# verification AVER_DUP_DEFER_AFTER times, move its remaining occurrences
# AVER_DUP_DEFER_DISTANCE places down the queue.
#AVER_DUP_DEFER_AFTER=5
#AVER_DUP_DEFER_DISTANCE=100

# Cloze count. Production default is 15 (4:4:2:2:2:1). Set to 100 only for
# evals; do not ship that as the service default.
#AVER_CLOZE_TOTAL=15
# Or a full JSON override of CLASSES_NUM:
#AVER_CLASSES_NUM={"unigrams_NOUN":4,"unigrams_ADJ":4,"trigrams_w_ADJ":2,"trigrams":2,"bigrams_NOUN_ADJ":2,"bigrams_ADV_ADJ":1}

# Inference batch size (cloze positions per model forward pass). Bigger =
# fewer forward passes per job = faster, but more memory per pass. On the
# CPU / OpenVINO deployment the sweet spot is ~5; on a GPU with plenty of
# VRAM it can be much larger. Use benchmark_batch_size.py to tune.
#AVER_BATCH_SIZE=5

# LM decision log. One JSON line per LM call (accept / spare / reject /
# reject_dup) with the candidate word, sentence, POS tags, and the model's
# top-K guesses with scores. Fuel for building a pre-filter / re-ranker
# classifier and for auditing recurrent rejects. Set to an empty string to
# disable. Rotate with logrotate; growth is roughly 50-100 KB per job.
#AVER_LM_DECISION_LOG=./lm_decisions.jsonl

# LM plausibility accept window (rank in the LM's ranked predictions for
# the blank). A candidate is accepted iff the model's rank of the original
# word (ml_pos) is in [AVER_MIN_RANGE, AVER_MAX_RANGE). The model returns
# 41 predictions per blank (num_beams = num_return_sequences = MAX_RANGE);
# the default [1, 41) keeps ranks 1..40. MIN_RANGE=1 (not 0) is deliberate:
# a word the model already puts at rank 0 (its very top guess) is too
# predictable to make a useful cloze question, so we filter it out.
#AVER_MIN_RANGE=1
#AVER_MAX_RANGE=41

# Text-quality filter (MLmethod/MT5_model_method.py). Defaults match production.
#AVER_FILTER_REFERENCES=1
#AVER_FILTER_STRUCTURAL=1
#AVER_FILTER_WEAK_TEXT=1
#AVER_FILTER_CITATIONS=1
#AVER_FILTER_BOILERPLATE=1
#AVER_FILTER_NON_LETTER_RATIO=0.40
#AVER_FILTER_MIN_ALPHA_TOKENS=8
#AVER_FILTER_MIN_CONTENT_TOKENS=3
#AVER_FILTER_MIN_CONTENT_RATIO=0.35
#AVER_FILTER_WEAK_SCORE=1

# Reject a sentence whose model-tokenized length exceeds this many tokens.
# Guards the worker against pathological "sentences" that are actually a whole
# bibliography or table row collapsed onto one line (usually a PDF-extraction
# glitch). Each such sentence spawns hundreds of candidate n-grams and can
# trip the OOM killer on CPU deployments. Set to 0 to disable.
#AVER_FILTER_MAX_SENTENCE_TOKENS=1024

# Language auto-correction (MLmethod/language_detection.py). OFF by default.
# When on, the worker runs a lightweight {en, cs, sk} detector over the
# joined paragraphs and swaps ``language`` when the detected value disagrees
# with the request. A wrong language silently activates the wrong POS tagger
# and stopword list, which is what let function words leak into n-gram
# candidates in the past. Set to 1 on deployments where callers cannot be
# trusted to declare the right language; leave off if the frontend is
# authoritative. The verdict (declared / detected / applied / scores /
# margin) is recorded on the response under ``language_correction`` and
# surfaced by ``aver_db.py show``. Accepts 1/true/yes/on and 0/false/no/off.
#AVER_LANGUAGE_AUTO_CORRECT=0

# ---------------------------------------------------------------------------
# GPU (worker, torch backend only)
# ---------------------------------------------------------------------------

# Use a GPU? empty/unset = auto (GPU if CUDA available), 1 = GPU, 0 = force CPU.
# NOTE: also read by setup_api.sh to decide whether to install a CUDA torch
# build, so set it BEFORE running setup_api.sh on a GPU machine.
#AVER_USE_GPU=1

# Minimum free VRAM (GB) a GPU must have to be picked.
#AVER_GPU_MIN_FREE_GB=14

# 1 = prefer a fully-idle GPU (whole node); 0 = any GPU meeting the VRAM bar.
#AVER_GPU_WHOLE_NODE=1

# When all GPUs are busy, wait this many seconds before retrying (600 = 10 min).
#AVER_GPU_WAIT_SECONDS=600

# A GPU with less than this much used VRAM (MiB) counts as "idle".
#AVER_GPU_IDLE_USED_MIB=300

# Restrict which physical GPUs are visible to this process (standard CUDA var).
#CUDA_VISIBLE_DEVICES=0,1,2

# ---------------------------------------------------------------------------
# Setup-time only (setup_api.sh), used when AVER_USE_GPU=1
# ---------------------------------------------------------------------------

# CUDA wheel channel and torch version to install for GPU.
#AVER_TORCH_CUDA=cu121
#AVER_TORCH_VERSION=2.4.1
